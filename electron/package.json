{
  "name": "chatpdf-desktop",
  "productName": "ChatPDF Pro",
  "version": "3.2.0",
  "description": "Agentic RAG paper and PDF reader",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsc && electron .",
    "build": "tsc",
    "start": "electron .",
    "validate:resources": "node scripts/validate-desktop-artifacts.mjs",
    "stamp:release": "node scripts/stamp-release-artifacts.mjs",
    "package": "npm run build && npm run validate:resources && electron-builder build --publish never --config.electronDist=node_modules/electron/dist && npm run stamp:release",
    "package:win": "npm run build && npm run validate:resources && electron-builder build --win --publish never --config.electronDist=node_modules/electron/dist && npm run stamp:release",
    "package:mac": "npm run build && npm run validate:resources && electron-builder build --mac --publish never --config.electronDist=node_modules/electron/dist && npm run stamp:release",
    "package:linux": "npm run build && npm run validate:resources && electron-builder build --linux --publish never --config.electronDist=node_modules/electron/dist && npm run stamp:release"
  },
  "author": "ChatPDF Team",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "get-port": "^7.0.0"
  },
  "build": {
    "appId": "com.chatpdf.desktop",
    "productName": "ChatPDF Pro",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "resources/icon.ico",
      "resources/icon.png"
    ],
    "extraResources": [
      {
        "from": "../frontend/build",
        "to": "renderer",
        "filter": [
          "**/*",
          "!data/**/*",
          "!uploads/**/*",
          "!logs/**/*",
          "!cache/**/*",
          "!history/**/*",
          "!memory/**/*",
          "!vector_stores/**/*",
          "!semantic_groups/**/*",
          "!overviews/**/*",
          "!parse/**/*",
          "!**/test/**/*",
          "!**/tests/**/*",
          "!**/fixture/**/*",
          "!**/fixtures/**/*",
          "!**/course/**/*",
          "!**/courses/**/*",
          "!**/eval/**/*",
          "!**/evaluation/**/*",
          "!**/evaluations/**/*",
          "!**/课程/**/*",
          "!**/.env",
          "!**/.env.*",
          "!**/*.log",
          "!**/*.pdf",
          "!**/*.db",
          "!**/*.sqlite",
          "!**/*.sqlite3",
          "!**/*.faiss",
          "!**/*.pkl",
          "!**/*.pickle",
          "!**/online_ocr_config.json",
          "!**/ocr_provider_usage.json",
          "!**/chat_history.json",
          "!**/history.json",
          "!**/*api_key*",
          "!**/*apikey*"
        ]
      },
      {
        "from": "../backend/dist/chatpdf-backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!data/**/*",
          "!uploads/**/*",
          "!logs/**/*",
          "!cache/**/*",
          "!history/**/*",
          "!memory/**/*",
          "!vector_stores/**/*",
          "!semantic_groups/**/*",
          "!overviews/**/*",
          "!parse/**/*",
          "!**/test/**/*",
          "!**/tests/**/*",
          "!**/fixture/**/*",
          "!**/fixtures/**/*",
          "!**/course/**/*",
          "!**/courses/**/*",
          "!**/eval/**/*",
          "!**/evaluation/**/*",
          "!**/evaluations/**/*",
          "!**/课程/**/*",
          "!**/.env",
          "!**/.env.*",
          "!**/*.log",
          "!**/*.pdf",
          "!**/*.db",
          "!**/*.sqlite",
          "!**/*.sqlite3",
          "!**/*.faiss",
          "!**/*.pkl",
          "!**/*.pickle",
          "!**/online_ocr_config.json",
          "!**/ocr_provider_usage.json",
          "!**/chat_history.json",
          "!**/history.json",
          "!**/*api_key*",
          "!**/*apikey*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "resources/icon.ico",
      "sign": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "resources/icon.icns"
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "resources/icon.png"
    }
  }
}
